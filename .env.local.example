# ============================================
# ManzAllone v2 - Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real secrets.

# --- Supabase ---
# From: https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
# server-side only, NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...
# Pooler URL used by supabase CLI (db push, gen-types). Password MUST be percent-encoded.
# Find under: Dashboard -> Project Settings -> Database -> Connection string -> Transaction/Session pooler.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<percent-encoded-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# --- Anthropic (Claude Sonnet 4.6) ---
# From: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
